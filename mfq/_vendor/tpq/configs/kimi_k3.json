{
  "schema": 1,
  "architecture": "kimi_k3",
  "display_name": "Kimi K3（TPQ）",
  "supports_parallel": true,
  "tested_tp_min": 2,
  "tested_tp_max": 8,
  "defaults": {
    "device": "cuda",
    "max_ctx": 4096,
    "max_new": 512,
    "temperature": 0.0,
    "top_p": 1.0,
    "spec": 0,
    "reasoning": "chat",
    "host": "0.0.0.0",
    "port": 8000,
    "max_queue": 16
  },
  "environment": {
    "TPQ_FUSED": "1",
    "TPQ_TP_GRAPH": "1",
    "TPQ_TP_DIRECT_INPUT": "1",
    "TPQ_TP_HIDDEN": "0",
    "TPQ_TP_HIDDEN_STATE": "0",
    "TPQ_SMALL_OP_TP": "4",
    "TPQ_DENSE_TP": "1",
    "TPQ_FIRST_DENSE_TP": "1",
    "TPQ_SHARED_MLP_TP": "1",
    "TPQ_ATTENTION_TP": "1",
    "TPQ_MLA_TP": "1",
    "TPQ_ROUTED_PROJECTION_TP": "0",
    "TPQ_ROUTED_DOWN_ROW_TP": "0",
    "TPQ_ROUTER_TP": "0",
    "TPQ_MOE_PRELUDE_TP": "0",
    "TPQ_MOE_ROUTE_DOWN_TP": "0",
    "TPQ_PAGED_LATENT_ATTENTION": "1",
    "TPQ_LINEAR_ROUTE_FUSED": "1",
    "TPQ_RESIDUAL_SINGLE_MAX_ROWS": "2",
    "TPQ_RESIDUAL_INVERSE_CACHE": "1",
    "TPQ_P12_SHARED": "direct",
    "TPQ_VRAM_WATCH": "1",
    "TPQ_CPU_PACKED": "1",
    "TPQ_CPU_PACKED_DIRECT": "1",
    "TPQ_CPU_THREADS": "48",
    "TPQ_CPU_NUMA": "auto",
    "TPQ_RAM_RESERVE_GB": "32",
    "TPQ_RESIDENT_RESERVE_GB": "32",
    "TPQ_VRAM_RESERVE_GB": "3",
    "TPQ_VRAM_RUNTIME_GB": "3"
  },
  "profiles": {
    "ram": {
      "description": "单卡计算；紧凑专家常驻RAM并按需进入显存缓存",
      "tp": 1,
      "environment": {
        "TPQ_KIMI_PACKED_HYBRID": "1"
      }
    },
    "parallel": {
      "description": "兼容名称：采用已验证的4卡全显存无owner真张量并行",
      "tp": 4,
      "environment": {
        "TPQ_MOE_PARALLELISM": "tensor",
        "TPQ_TP_PARALLEL_LAUNCH": "0",
        "TPQ_TP_HIDDEN": "1",
        "TPQ_TP_HIDDEN_STATE": "1",
        "TPQ_TP_NO_OWNER": "1",
        "TPQ_TP_LAYER_GRAPH": "1",
        "TPQ_TP_MOE_PLAN": "1",
        "TPQ_TP_DECODE_LAYER_PLAN": "1",
        "TPQ_ROUTED_WARPS": "8",
        "TPQ_MOE_ROUTE_DOWN_TP": "1"
      }
    },
    "parallel_tp4": {
      "description": "推荐：4卡全显存无owner真张量并行；全rank固定地址父图",
      "tp": 4,
      "environment": {
        "TPQ_MOE_PARALLELISM": "tensor",
        "TPQ_TP_PARALLEL_LAUNCH": "0",
        "TPQ_TP_HIDDEN": "1",
        "TPQ_TP_HIDDEN_STATE": "1",
        "TPQ_TP_NO_OWNER": "1",
        "TPQ_TP_LAYER_GRAPH": "1",
        "TPQ_TP_MOE_PLAN": "1",
        "TPQ_TP_DECODE_LAYER_PLAN": "1",
        "TPQ_ROUTED_WARPS": "8",
        "TPQ_MOE_ROUTE_DOWN_TP": "1"
      }
    },
    "parallel_tp8": {
      "description": "推荐高速：8卡全显存无owner真张量并行；全rank并行提交",
      "tp": 8,
      "environment": {
        "TPQ_MOE_PARALLELISM": "tensor",
        "TPQ_TP_PARALLEL_LAUNCH": "1",
        "TPQ_TP_HIDDEN": "1",
        "TPQ_TP_HIDDEN_STATE": "1",
        "TPQ_TP_NO_OWNER": "1",
        "TPQ_TP_LAYER_GRAPH": "1",
        "TPQ_TP_MOE_PLAN": "1",
        "TPQ_TP_DECODE_LAYER_PLAN": "1",
        "TPQ_TP_FUSED_MOE_FINALIZE": "1",
        "TPQ_TP_EVENT_BARRIER": "1",
        "TPQ_ROUTED_WARPS": "8",
        "TPQ_MOE_ROUTE_DOWN_TP": "1"
      }
    }
