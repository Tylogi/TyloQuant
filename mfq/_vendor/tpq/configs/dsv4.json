{
  "schema": 1,
  "architecture": "dsv4",
  "display_name": "DeepSeek-V4 / DSpark（CCCP）",
  "supports_parallel": false,
  "defaults": {
    "device": "cuda",
    "max_ctx": 4096,
    "max_new": 512,
    "temperature": 0.0,
    "top_p": 1.0,
    "spec": 0,
    "reasoning": "chat",
    "host": "0.0.0.0",
    "port": 8000,
    "max_queue": 16
  },
  "environment": {
    "TPQ_COMPUTE_DTYPE": "bf16",
    "TPQ_DENSE_BF16": "all",
    "TPQ_FUSED": "1",
    "TPQ_PAGED_KV_FUSED": "1",
    "TPQ_VRAM_WATCH": "1",
    "TPQ_CPU_THREADS": "auto",
    "TPQ_CPU_NUMA": "auto",
    "TPQ_CPU_VQ_INT8": "0",
    "TPQ_RAM_RESERVE_GB": "32",
    "TPQ_RESIDENT_RESERVE_GB": "32",
    "TPQ_VRAM_RESERVE_GB": "2",
    "TPQ_VRAM_RUNTIME_GB": "1.5"
  },
  "profiles": {
    "ram": {
      "description": "单卡计算；压缩专家常驻 RAM，DSpark 默认关闭以保证基础稳定性",
      "tp": 1,
      "environment": {
        "TPQ_RAM_MIRROR": "0"
      }
    }
  }
}
