        mfq_tensor_backend::Tensor neuron_minimum,
        mfq_tensor_backend::Tensor input,
        mfq_tensor_backend::Tensor gate,
        int64_t activation_mode,
        int64_t group_size,
        mfq_tensor_backend::Tensor quantized_input,
