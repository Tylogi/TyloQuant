{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MFQ Studio",
  "version": "0.1.0",
  "identifier": "com.tylogi.mfq-studio",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MFQ Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "externalBin": [
      "../../../release/sidecars/mfq-decode-metal",
      "../../../release/sidecars/mfq-perplexity"
    ],
    "resources": {
      "../../../release/Resources/mlx.metallib": "mlx.metallib",
      "../../../release/Resources/mfq-cli": "mfq-cli"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.2",
      "frameworks": [
        "../../../release/Frameworks/libmlx.dylib",
        "../../../release/Frameworks/libjaccl.dylib",
        "../../../release/Frameworks/libmfq_avfoundation_video.dylib"
      ]
    }
  }
}
